<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GIMI_ModManager.WinUI.Views.CharacterDetailsPages.CharacterDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:characterDetailsPages="using:GIMI_ModManager.WinUI.Views.CharacterDetailsPages"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:controls1="using:GIMI_ModManager.WinUI.Views.Controls"
    xmlns:converters="using:CommunityToolkit.WinUI.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:GIMI_ModManager.WinUI.Models"
    xmlns:notifications="using:GIMI_ModManager.WinUI.Services.Notifications"
    xmlns:subViewModels="using:GIMI_ModManager.WinUI.ViewModels.CharacterDetailsViewModels.SubViewModels"
    xmlns:viewModels="using:GIMI_ModManager.WinUI.Models.ViewModels"
    xmlns:appViewModels="using:GIMI_ModManager.WinUI.ViewModels"
    xmlns:xaml="using:GIMI_ModManager.WinUI.Helpers.Xaml"
    xmlns:l="using:WinUI3Localizer"
    x:Name="CharacterDetailsRoot"
    mc:Ignorable="d">

    <Grid Margin="{StaticResource NegativeNavigationViewPageContentMargin}">


        <Grid.Resources>
            <Flyout
                x:Name="ModRowFlyout"
                Closing="ModRowFlyout_OnClosing"
                Opened="ModRowFlyout_OnOpened"
                Opening="ModRowFlyout_OnOpening"
                Placement="RightEdgeAlignedBottom"
                ShouldConstrainToRootBounds="False">
                <Grid Width="400">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid BorderBrush="{ThemeResource ControlElevationBorderBrush}" BorderThickness="0,0,0,4">
                        <Grid>
                            <StackPanel Orientation="Horizontal">

                                <TextBlock
                                    Margin="0,0,4,0"
                                    HorizontalAlignment="Left"
                                    Text="Mods Selected:" l:Uids.Uid="CharacterDetails_ModsSelected" />
                                <TextBlock HorizontalAlignment="Left" Text="{x:Bind ViewModel.ContextMenuVM.SelectedModsCount, Mode=OneWay}" />
                            </StackPanel>
                            <Button
                                Padding="0"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ViewModel.DeleteModsCommand}">
                                <FontIcon FontSize="16" Glyph="&#xE74D;" />
                            </Button>
                        </Grid>
                    </Grid>

                    <Grid
                        Grid.Row="1"
                        Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="MoveModsButton"
                            VerticalAlignment="Bottom"
                            Margin="0,0,16,0"
                            Command="{x:Bind ViewModel.ContextMenuVM.MoveModsCommand}"
                            Content="Move" l:Uids.Uid="CharacterDetails_MoveModsButton" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Move Mods To Another Character: " l:Uids.Uid="CharacterDetails_MoveModsToAnother" />
                            <AutoSuggestBox
                                x:Name="MoveModSearchBox"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind ViewModel.IsNotHardBusy, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.ContextMenuVM.SuggestedModdableObjects, Mode=OneWay}"
                                PlaceholderText="Search..." l:Uids.Uid="CharacterDetails_MoveModSearch"
                                QuerySubmitted="MoveModSearch_OnQuerySubmitted"
                                TextChanged="MoveModSearch_OnTextChanged"
                                Text="{x:Bind ViewModel.ContextMenuVM.MoveModsSearchText, Mode=TwoWay}">
                                <AutoSuggestBox.ItemTemplate>
                                    <DataTemplate x:DataType="subViewModels:SuggestedModObject">
                                        <TextBlock FontFamily="{StaticResource GenshinFont}" Text="{x:Bind DisplayName}" />
                                    </DataTemplate>
                                </AutoSuggestBox.ItemTemplate>
                            </AutoSuggestBox>
                        </StackPanel>

                    </Grid>

                    <StackPanel
                        Grid.Row="2"
                        Margin="0,4,0,4"
                        Padding="0,4,0,0"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="0,4,0,0">
                        <Expander
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            ExpandDirection="Down"
                            Header="Move Mods to another Skin" l:Uids.Uid="CharacterDetails_MoveModsSkinExpander"
                            IsEnabled="{x:Bind ViewModel.ContextMenuVM.MultipleSkins, Mode=OneWay}"
                            IsExpanded="False">
                            <Expander.Content>
                                <StackPanel>
                                    <controls1:SelectCharacterFromGrid GridSource="{x:Bind ViewModel.ContextMenuVM.SelectableCharacterSkins, Mode=OneWay}" ItemClickedCommand="{x:Bind ViewModel.ContextMenuVM.SelectNewCharacterSkinCommand}" />

                                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                        <Button HorizontalAlignment="Left" Command="{x:Bind ViewModel.ContextMenuVM.OverrideModCharacterSkinCommand}">
                                            <Button.Content>
                                                <StackPanel Orientation="Horizontal">
                                                    <FontIcon Margin="0,0,4,0" Glyph="&#xE74E;" />
                                                    <TextBlock Text="Override" l:Uids.Uid="CharacterDetails_OverrideText" />
                                                </StackPanel>
                                            </Button.Content>
                                        </Button>

                                        <StackPanel Margin="4,0,0,0" Visibility="{x:Bind ViewModel.ContextMenuVM.ModHasCharacterSkinOverride, Mode=OneWay}">
                                            <TextBlock Text="Override Skin Set To: " l:Uids.Uid="CharacterDetails_OverrideSkinSetTo" />
                                            <TextBlock HorizontalAlignment="Center" Text="{x:Bind ViewModel.ContextMenuVM.ModCharacterSkinOverride.DisplayName, FallbackValue='', Mode=OneWay}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Expander.Content>
                        </Expander>
                    </StackPanel>

                    <StackPanel
                        Grid.Row="3"
                        Margin="0,4,0,4"
                        Padding="0,4,0,0"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="0,4,0,0">
                        <Expander
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            ExpandDirection="Down"
                            Header="Run Command on this folder" l:Uids.Uid="CharacterDetails_RunCommandExpander"
                            IsEnabled="{x:Bind ViewModel.ContextMenuVM.IsSingleModSelected, Mode=OneWay}"
                            IsExpanded="False">
                            <Expander.Content>
                                <ListView
                                    MaxHeight="350"
                                    ItemsSource="{x:Bind ViewModel.ContextMenuVM.CommandDefinitions}"
                                    SelectionMode="None">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="appViewModels:ModOverviewCommandVM">
                                            <Grid
                                                Margin="0,4,0,4"
                                                Padding="4"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                ColumnSpacing="4"
                                                CornerRadius="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="4">
                                                    <TextBlock
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTipService.ToolTip="{x:Bind DisplayName}"
                                                        Text="{x:Bind DisplayName}" />

                                                    <StackPanel>
                                                        <TextBlock IsTextSelectionEnabled="True" Text="Full Command:" l:Uids.Uid="CharacterDetails_FullCommand" />
                                                        <TextBlock
                                                            Padding="6,0,0,0"
                                                            IsTextSelectionEnabled="True"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTipService.ToolTip="{x:Bind FullCommand}"
                                                            Text="{x:Bind FullCommand}" />
                                                    </StackPanel>

                                                    <StackPanel>
                                                        <TextBlock IsTextSelectionEnabled="True" Text="Working Directory:" l:Uids.Uid="CharacterDetails_WorkingDirectory" />
                                                        <TextBlock
                                                            Padding="6,0,0,0"
                                                            IsTextSelectionEnabled="True"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTipService.ToolTip="{x:Bind WorkingDirectory}"
                                                            Text="{x:Bind WorkingDirectory}" />
                                                    </StackPanel>

                                                    <StackPanel>
                                                        <TextBlock IsTextSelectionEnabled="True" Text="'{{TargetPath}}:" />
                                                        <TextBlock
                                                            Padding="6,0,0,0"
                                                            IsTextSelectionEnabled="True"
                                                            Tag="TargetPathText"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTipService.ToolTip="{x:Bind TargetPath, Mode=OneWay}"
                                                            Text="{x:Bind TargetPath, Mode=OneWay}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <Button
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Command="{x:Bind RunCommand}"
                                                    CommandParameter="{x:Bind}"
                                                    Content="Run" l:Uids.Uid="CharacterDetails_RunCommandButton"
                                                    Style="{ThemeResource AccentButtonStyle}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Expander.Content>
                        </Expander>
                    </StackPanel>
                </Grid>
            </Flyout>

        </Grid.Resources>


        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10*" />
            </Grid.ColumnDefinitions>

            <characterDetailsPages:CharacterCard x:Name="CharacterCard" />


            <Grid x:Name="PageInitLoader" Grid.Column="1">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Visible">
                    <ProgressRing />
                    <TextBlock>
                        <Run Text="Loading" l:Uids.Uid="CharacterDetails_LoadingText" />
                        <Run Text="{x:Bind ViewModel.LoadingItemText, Mode=OneWay}" />
                        <Run Text="..." />

                    </TextBlock>
                </StackPanel>
            </Grid>

            <Grid
                x:Name="RightWorkingArea"
                Grid.Column="1"
                Margin="4,0,4,0"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Grid x:Name="ToolBarArea" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>


                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <MenuBar IsEnabled="{x:Bind ViewModel.IsNotHardBusy, Mode=OneWay}">
                                <MenuBarItem Title="Mods" l:Uids.Uid="CharacterDetails_MenuBar_Mods">
                                    <MenuBarItem.Items>
                                        <MenuFlyoutItem
                                            Command="{x:Bind ViewModel.AddModFolderCommand}"
                                            ToolTipService.ToolTip="Add a mod folder"
                                            Text="Add Mod..." l:Uids.Uid="CharacterDetails_AddModMenuItem" />

                                        <MenuFlyoutItem
                                            Command="{x:Bind ViewModel.AddModArchiveCommand}"
                                            ToolTipService.ToolTip="Add a mod inside a compressed archive"
                                            Text="Add Archive..." l:Uids.Uid="CharacterDetails_AddArchiveMenuItem">
                                            <MenuFlyoutItem.KeyboardAccelerators>
                                                <KeyboardAccelerator Key="O" Modifiers="Control" />
                                            </MenuFlyoutItem.KeyboardAccelerators>
                                        </MenuFlyoutItem>

                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Command="{x:Bind ViewModel.RefreshAllModsCommand}" Text="Refresh Mods" l:Uids.Uid="CharacterDetails_RefreshMods">
                                            <MenuFlyoutItem.KeyboardAccelerators>
                                                <KeyboardAccelerator Key="F5" />
                                            </MenuFlyoutItem.KeyboardAccelerators>
                                        </MenuFlyoutItem>
                                    </MenuBarItem.Items>
                                </MenuBarItem>

                                <MenuBarItem Title="Folders" l:Uids.Uid="CharacterDetails_MenuBar_Folders">
                                    <MenuFlyoutItem Command="{x:Bind ViewModel.OpenGIMIRootFolderCommand}" Text="Open 3Dmigoto Root folder..." l:Uids.Uid="CharacterDetails_OpenGIMIRootFolder" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Command="{x:Bind ViewModel.OpenCharacterFolderCommand}" Text="Open Character's Mod folder..." l:Uids.Uid="CharacterDetails_OpenCharacterModFolder" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        Command="{x:Bind ViewModel.OpenModFolderCommand}"
                                        IsEnabled="{x:Bind ViewModel.ModGridVM.IsSingleModSelected, Mode=OneWay}"
                                        Text="Open Selected Mod folder..." l:Uids.Uid="CharacterDetails_OpenSelectedModFolder" />
                                </MenuBarItem>

                                <MenuBarItem Title="View" l:Uids.Uid="CharacterDetails_MenuBar_View">
                                    <ToggleMenuFlyoutItem
                                        Command="{x:Bind ViewModel.ToggleSingleSelectCommand}"
                                        IsChecked="{x:Bind ViewModel.IsSingleSelectEnabled, Mode=OneWay}"
                                        ToolTipService.ToolTip="Selecting this will only allow one mod to be enabled at a time."
                                        Text="Single Select" l:Uids.Uid="CharacterDetails_SingleSelectToggle" />
                                    <ToggleMenuFlyoutItem
                                        Command="{x:Bind ViewModel.ToggleHideModFolderColumnCommand}"
                                        IsChecked="{x:Bind ViewModel.IsModFolderNameColumnVisible, Mode=OneWay}"
                                        Text="Show 'Mod Folder Names' column" l:Uids.Uid="CharacterDetails_ShowModFolderColumn" />
                                </MenuBarItem>

                                <MenuBarItem
                                    Title="Mod Preferences" l:Uids.Uid="CharacterDetails_MenuBar_ModPreferences"
                                    IsEnabled="{x:Bind ViewModel.IsSingleModSelected, Mode=OneWay}"
                                    Visibility="Collapsed">
                                    <ToggleMenuFlyoutItem x:Name="SavePreferencesMenuItem" ToolTipService.ToolTip="Reads 3Dmigoto mod preferences (d3dx_user.ini) for the selected mod and stores the settings in the Mod's .JASM_Config.json file" Text="Save preferences for selected mod" />
                                    <MenuFlyoutSeparator />
                                    <ToggleMenuFlyoutItem x:Name="ReadPreferencesMenuItem" ToolTipService.ToolTip="Reads the currently selected mod's preferences from .JASM_Config.json and writes them to d3dx_user.ini for 3Dmigoto to read" Text="Read preferences for selected mod" />
                                </MenuBarItem>
                            </MenuBar>

                        </StackPanel>


                        <InfoBar
                            x:Name="MultipleModsInfoBar"
                            Grid.Column="1"
                            Height="50"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.ModGridVM.ShowMultipleModsActiveWarning, Mode=OneWay}"
                            Message="Multiple Mods active"
                            Severity="Warning"
                            Visibility="Visible" />

                    </Grid>



                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="16">

                        <InfoBar
                            Height="50"
                            VerticalAlignment="Center"
                            IsClosable="False"
                            Visibility="Visible" />

                        <StackPanel VerticalAlignment="Center">
                            <TextBox
                                x:Name="SearchModsTextBox"
                                MinWidth="200"
                                MaxWidth="500"
                                IsEnabled="{x:Bind ViewModel.IsNotHardBusy, Mode=OneWay}"
                                PlaceholderText="Search Mods..." l:Uids.Uid="CharacterDetails_SearchModsTextBox"
                                TextChanged="SearchModsTextBox_OnTextChanged"
                                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

                                <TextBox.KeyboardAccelerators>
                                    <KeyboardAccelerator
                                        Key="F"
                                        Invoked="KeyboardAccelerator_OnInvoked"
                                        Modifiers="Control" />
                                </TextBox.KeyboardAccelerators>

                            </TextBox>
                        </StackPanel>


                        <ToggleSwitch
                            x:Name="ViewToggleSwitch"
                            IsOn="False"
                            OffContent="Detailed View"
                            OnContent="Gallery View"
                            Loaded="ViewToggleSwitch_OnLoaded"
                            Toggled="ViewToggleSwitch_OnToggled" />

                        <Grid MinWidth="32">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsWorking, Mode=OneWay}" />
                        </Grid>

                    </StackPanel>

                </Grid>
                <Grid
                    x:Name="MainContentArea"
                    Grid.Row="1"
                    AllowDrop="False"
                    Background="Transparent"
                    DragEnter="ModListArea_OnDragEnter"
                    Drop="ModListArea_OnDrop">

                    <!--
                        We need drop handling on both  MainContentArea and ModListArea, but only one is active at the time
                        This is because of the "This character has no mods" page that is shown if there are no mods
                    -->

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="7*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            x:Name="ModListArea"
                            AllowDrop="True"
                            Background="Transparent"
                            CornerRadius="10"
                            DragEnter="ModListArea_OnDragEnter"
                            Drop="ModListArea_OnDrop">
                            <characterDetailsPages:ModGrid x:Name="ModGrid" IsEnabled="{x:Bind ViewModel.IsNotHardBusy, Mode=OneWay}" />

                        </Grid>

                        <characterDetailsPages:ModPane
                            x:Name="ModPane"
                            Grid.Column="1"
                            IsEnabled="{x:Bind ViewModel.IsNotHardBusy, Mode=OneWay}" />

                        <controls:GridSplitter
                            x:Name="ModPaneSplitter"
                            Grid.Column="1"
                            Width="8"
                            Height="40"
                            HorizontalAlignment="Left"
                            ResizeBehavior="BasedOnAlignment"
                            ResizeDirection="Auto">
                            <controls:GridSplitter.RenderTransform>
                                <TranslateTransform X="-10" />
                            </controls:GridSplitter.RenderTransform>
                        </controls:GridSplitter>
                    </Grid>
                </Grid>
            </Grid>


        </Grid>
    </Grid>
</Page>
